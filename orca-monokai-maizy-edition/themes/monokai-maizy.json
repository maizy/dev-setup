{
  "schemaVersion": 1,
  "base": "dark",
  "tokens": {
    "--background": "#272822",
    "--editor-surface": "#272822",
    "--card": "#1e1f1c",
    "--popover": "#1e1f1c",
    "--primary": "#a6e22e",
    "--secondary": "#3e3d32",
    "--muted": "#272822",
    "--accent": "#3e3d32",
    "--border": "#414339",
    "--input": "#414339",
    "--sidebar": "#1e1f1c",
    "--sidebar-border": "#414339",
    "--foreground": "#f8f8f2",
    "--popover-foreground": "#f8f8f2",
    "--primary-foreground": "#272822",
    "--secondary-foreground": "#f8f8f2",
    "--muted-foreground": "#90908a",
    "--accent-foreground": "#f8f8f2",
    "--ring": "#66d9ef",
    "--sidebar-foreground": "#f8f8f2"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#75715e"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#e6db74"
      }
    },
    {
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ae81ff"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ae81ff"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.operator",
        "storage",
        "storage.modifier",
        "entity.name.tag",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#f92672"
      }
    },
    {
      "scope": [
        "storage.type",
        "support.type",
        "support.class",
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#66d9ef",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.other.inherited-class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#a6e22e",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#fd971f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "support.constant",
        "support.variable"
      ],
      "settings": {
        "foreground": "#66d9ef"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f8f8f0"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ae81ff",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#a6e22e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#fd971f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#e6db74",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline",
        "string.other.link",
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#66d9ef",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#75715e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "#a6e22e"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "#f92672"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#e6db74"
      }
    },
    {
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#75715e"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#f92672",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#e6db74",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ae81ff",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#d38bc4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#94558d",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable.other.static"
      ],
      "settings": {
        "foreground": "#9a5ba8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#fda5ff",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block"
      ],
      "settings": {
        "foreground": "#ae81ff",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#ae81ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#d8e9fd",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "keyword.other.todo",
        "comment keyword.other.todo"
      ],
      "settings": {
        "foreground": "#c7c7ff",
        "fontStyle": "bold italic"
      }
    }
  ]
}
